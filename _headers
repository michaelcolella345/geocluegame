# Cloudflare Pages caching rules. Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Fonts and images never change, so browsers can keep them for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

# The page, code and puzzles are re-checked on every visit so new puzzles and fixes show up right away.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for every page.
# - Content-Security-Policy only lets the page run code from this site plus the two analytics
#   services (Cloudflare Web Analytics and GoatCounter), so injected scripts can't run.
#   The sha256 value allows the one small inline theme script at the top of index.html and 404.html.
#   If you ever edit that inline script, the hash must be updated or dark mode stops loading early.
# - Strict-Transport-Security tells browsers to always use https for this site.
# - X-Frame-Options and frame-ancestors stop other sites from embedding GeoClue in a frame.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Tm80C22A7wkwC+hl6bXLNU19DWnPdlZK1B2OSzT7sik=' https://static.cloudflareinsights.com https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.goatcounter.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
